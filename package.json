{
  "name": "vkrana-me",
  "version": "2.1.0",
  "description": "Personal CLI for Vijendra Rana (vkrana).",
  "type": "module",
  "bin": {
    "vkrana-me": "dist/vkrana-me.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun build src/vkrana-me.ts --outdir dist --target bun --packages external",
    "dev": "bun run src/vkrana-me.ts",
    "start": "bun ./dist/vkrana-me.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "gen:avatar": "bun scripts/gen-avatar.ts"
  },
  "keywords": [
    "cli",
    "vkrana"
  ],
  "author": "Vijendra Rana <vij.rana.tech@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "@opentui/core": "^0.8.2",
    "@opentui/react": "^0.8.2",
    "commander": "^12.1.0",
    "headroom-ai": "^0.22.4",
    "react": "^19.2.0",
    "wrap-ansi": "^9.0.2"
  }
}
